<Window x:Class="GlowDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GlowDeck.Models"
        mc:Ignorable="d"
        Title="GlowDeck"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        Background="{StaticResource WindowBrush}"
        Foreground="#F4F6FB"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <DataTemplate x:Key="DeviceCardTemplate" DataType="{x:Type models:LightingDevice}">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsControllable}"
                              VerticalAlignment="Top"
                              Margin="0,3,0,0" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding GroupName}"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Details}"
                                   Foreground="#BCC7D4"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Status}"
                                   Foreground="#E0B86B"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Background="#202C3A"
                            BorderBrush="#34465B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,7"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding LedCountLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionStateLabel}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SceneCardTemplate" DataType="{x:Type models:LightingScene}">
            <Border Background="#151E2A"
                    BorderBrush="#2A3949"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,5,0,0" />
                    <TextBlock Text="{Binding PaletteText}"
                               Foreground="#D4DCE6"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0E151E"
                BorderBrush="#202C39"
                BorderThickness="0,0,1,0"
                Padding="20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="GLOWDECK"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#FFFFFF" />
                    <TextBlock Text="Lighting studio"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,28" />
                    <Button x:Name="DevicesNavButton"
                            Content="Devices"
                            HorizontalContentAlignment="Left"
                            Background="#27263F"
                            BorderBrush="#534C85"
                            Click="ShowDevices_Click"
                            Margin="0,0,0,8" />
                    <Button x:Name="ScenesNavButton"
                            Content="Scenes"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="ShowScenes_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border Height="1" Background="#273443" Margin="0,0,0,14" />
                    <TextBlock Text="RGB BACKEND"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                    <TextBlock x:Name="BackendStatusText"
                               Text="Checking..."
                               Foreground="#E0B86B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                    <Button x:Name="InstallBackendButton"
                            Content="Set up RGB backend"
                            Click="InstallBackendButton_Click"
                            Visibility="Collapsed"
                            Padding="8,7"
                            Margin="0,10,0,0" />
                    <TextBlock Text="Philips Hue integration is planned."
                               Foreground="#77879A"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText"
                               Text="Your devices"
                               FontSize="25"
                               FontWeight="Bold" />
                    <TextBlock x:Name="PageSubtitleText"
                               Text="Choose a group, set a look, and apply it to compatible devices."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>
                <Button x:Name="RefreshButton"
                        Content="Refresh devices"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="RefreshButton_Click" />
            </Grid>

            <Grid x:Name="DevicesView" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="354" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Detected devices" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="DeviceCountText"
                                           Text="Scanning hardware..."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="GroupFilterCombo"
                                      Grid.Column="1"
                                      SelectionChanged="GroupFilterCombo_SelectionChanged"
                                      SelectedIndex="0"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="All groups" Tag="All" />
                                <ComboBoxItem Content="Case lighting" Tag="CaseLighting" />
                                <ComboBoxItem Content="Motherboard" Tag="Motherboard" />
                                <ComboBoxItem Content="Memory" Tag="Memory" />
                                <ComboBoxItem Content="Razer devices" Tag="Razer" />
                                <ComboBoxItem Content="Other devices" Tag="Other" />
                            </ComboBox>
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Select visible"
                                    Click="SelectVisible_Click"
                                    Padding="11,7"
                                    Margin="0,0,8,0" />
                            <Button Content="Select all ready"
                                    Click="SelectAllReady_Click"
                                    Padding="11,7"
                                    Margin="0,0,8,0" />
                            <Button Content="Clear selection"
                                    Click="ClearSelection_Click"
                                    Padding="11,7" />
                        </WrapPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,16,0">
                        <ItemsControl x:Name="DeviceList" ItemTemplate="{StaticResource DeviceCardTemplate}" />
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Quick controls" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Set one color or build a small palette for an animated scene."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,16" />

                            <Border x:Name="LianLiSetupPanel"
                                    Background="#151E2A"
                                    BorderBrush="#34465B"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,12"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Lian Li UNI HUB SL setup"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="LianLiSetupStatusText"
                                               Text="OpenRGB channel layout."
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="108" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Channel 1 fans"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,6" />
                                        <ComboBox x:Name="LianLiChannel1FanCountCombo"
                                                  Grid.Column="1"
                                                  SelectedIndex="2"
                                                  Margin="0,0,0,6">
                                            <ComboBoxItem Content="1 fan" Tag="1" />
                                            <ComboBoxItem Content="2 fans" Tag="2" />
                                            <ComboBoxItem Content="3 fans" Tag="3" />
                                            <ComboBoxItem Content="4 fans" Tag="4" />
                                        </ComboBox>
                                        <TextBlock Grid.Row="1"
                                                   Text="Channel 2 fans"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,6" />
                                        <ComboBox x:Name="LianLiChannel2FanCountCombo"
                                                  Grid.Row="1"
                                                  Grid.Column="1"
                                                  SelectedIndex="2"
                                                  Margin="0,0,0,6">
                                            <ComboBoxItem Content="1 fan" Tag="1" />
                                            <ComboBoxItem Content="2 fans" Tag="2" />
                                            <ComboBoxItem Content="3 fans" Tag="3" />
                                            <ComboBoxItem Content="4 fans" Tag="4" />
                                        </ComboBox>
                                        <TextBlock Grid.Row="2"
                                                   Text="Channel 4 fans"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <ComboBox x:Name="LianLiChannel4FanCountCombo"
                                                  Grid.Row="2"
                                                  Grid.Column="1"
                                                  SelectedIndex="2">
                                            <ComboBoxItem Content="1 fan" Tag="1" />
                                            <ComboBoxItem Content="2 fans" Tag="2" />
                                            <ComboBoxItem Content="3 fans" Tag="3" />
                                            <ComboBoxItem Content="4 fans" Tag="4" />
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="Channel 3 is the case front strip; this fan setup leaves it untouched."
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                    <Button x:Name="ConfigureLianLiButton"
                                            Content="Configure fan channels"
                                            Click="ConfigureLianLiButton_Click"
                                            IsEnabled="False"
                                            Padding="10,7"
                                            Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Custom color" FontWeight="SemiBold" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ColorHexText"
                                         Text="#8B5CF6"
                                         MaxLength="7"
                                         VerticalContentAlignment="Center"
                                         TextChanged="ColorHexText_TextChanged" />
                                <Border x:Name="ColorPreview"
                                        Grid.Column="1"
                                        Background="#8B5CF6"
                                        BorderBrush="#FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="9,0,0,0" />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Violet" Tag="#8B5CF6" Click="PaletteButton_Click" Padding="9,6" Margin="0,0,6,6" />
                                <Button Content="Ice" Tag="#4DBEFF" Click="PaletteButton_Click" Padding="9,6" Margin="0,0,6,6" />
                                <Button Content="Teal" Tag="#35D6B0" Click="PaletteButton_Click" Padding="9,6" Margin="0,0,6,6" />
                                <Button Content="Amber" Tag="#FFB45F" Click="PaletteButton_Click" Padding="9,6" Margin="0,0,6,6" />
                                <Button Content="Rose" Tag="#F472B6" Click="PaletteButton_Click" Padding="9,6" Margin="0,0,6,6" />
                                <Button Content="White" Tag="#FFFFFF" Click="PaletteButton_Click" Padding="9,6" Margin="0,0,6,6" />
                            </WrapPanel>

                            <TextBlock Text="Scene palette (hex colors, comma separated)"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0" />
                            <TextBox x:Name="PaletteTextBox"
                                     Text="#8B5CF6, #22D3EE, #F472B6"
                                     Margin="0,7,0,0"
                                     TextWrapping="Wrap"
                                     MinHeight="58"
                                     AcceptsReturn="True" />
                            <Button Content="Add custom color to palette"
                                    Click="AddColor_Click"
                                    HorizontalAlignment="Left"
                                    Padding="10,7"
                                    Margin="0,8,0,0" />

                            <TextBlock Text="Effect" FontWeight="SemiBold" Margin="0,18,0,0" />
                            <ComboBox x:Name="EffectCombo" SelectedIndex="0" Margin="0,7,0,0">
                                <ComboBoxItem Content="Solid color" Tag="Solid" />
                                <ComboBoxItem Content="Breathing" Tag="Breathing" />
                                <ComboBoxItem Content="Color cycle" Tag="ColorCycle" />
                                <ComboBoxItem Content="Rainbow" Tag="Rainbow" />
                            </ComboBox>

                            <DockPanel Margin="0,15,0,0">
                                <TextBlock Text="Speed" FontWeight="SemiBold" />
                                <TextBlock x:Name="SpeedValueText"
                                           Text="45"
                                           Foreground="{StaticResource MutedBrush}"
                                           DockPanel.Dock="Right" />
                            </DockPanel>
                            <Slider x:Name="SpeedSlider"
                                    Minimum="1"
                                    Maximum="100"
                                    Value="45"
                                    ValueChanged="SpeedSlider_ValueChanged" />

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="Brightness" FontWeight="SemiBold" />
                                <TextBlock x:Name="BrightnessValueText"
                                           Text="75%"
                                           Foreground="{StaticResource MutedBrush}"
                                           DockPanel.Dock="Right" />
                            </DockPanel>
                            <Slider x:Name="BrightnessSlider"
                                    Minimum="1"
                                    Maximum="100"
                                    Value="75"
                                    ValueChanged="BrightnessSlider_ValueChanged" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Apply to selected"
                                        Click="ApplySelected_Click"
                                        Padding="11,8"
                                        Margin="0,0,8,0" />
                                <Button Content="Apply to group"
                                        Click="ApplyGroup_Click"
                                        Padding="11,8" />
                            </StackPanel>
                            <Button Content="Apply to all compatible devices"
                                    Click="ApplyAll_Click"
                                    Background="#6555D9"
                                    BorderBrush="#8A7DFF"
                                    Padding="11,9"
                                    Margin="0,8,0,0" />

                            <TextBlock Text="Save this look as a scene"
                                       FontWeight="SemiBold"
                                       Margin="0,18,0,0" />
                            <TextBox x:Name="SceneNameTextBox"
                                     Text="My scene"
                                     Margin="0,7,0,0" />
                            <Button Content="Save scene"
                                    Click="SaveScene_Click"
                                    HorizontalAlignment="Left"
                                    Padding="11,8"
                                    Margin="0,8,0,0" />
                            <TextBlock x:Name="ActionStatusText"
                                       Text="RGB commands are only sent after you press an Apply button."
                                       Foreground="#A9B7C6"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,15,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="ScenesView" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="354" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="18"
                        Margin="0,0,16,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="Scene library" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Pick a preset or save your own from the device controls."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <ListBox x:Name="ScenesList"
                                 ItemTemplate="{StaticResource SceneCardTemplate}"
                                 SelectionChanged="ScenesList_SelectionChanged" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Scene details" FontSize="18" FontWeight="SemiBold" />
                        <Border x:Name="ScenePreview"
                                Background="#8B5CF6"
                                Height="94"
                                CornerRadius="12"
                                Margin="0,14,0,14" />
                        <TextBlock x:Name="SceneDetailsName"
                                   Text="Select a scene"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SceneDetailsSummary"
                                   Text="Scene settings appear here."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <TextBlock x:Name="SceneDetailsPalette"
                                   Foreground="#D4DCE6"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                        <Button Content="Load into controls"
                                Click="LoadScene_Click"
                                Margin="0,20,0,0" />
                        <Button Content="Apply scene"
                                Click="ApplyScene_Click"
                                Background="#6555D9"
                                BorderBrush="#8A7DFF"
                                Margin="0,8,0,0" />
                        <Button x:Name="DeleteSceneButton"
                                Content="Delete custom scene"
                                Click="DeleteScene_Click"
                                IsEnabled="False"
                                Margin="0,8,0,0" />
                        <TextBlock Text="Animated scenes run only while GlowDeck is open."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
